# Copy this file to .env.local and fill in real values.
# See README.md for where each Supabase value comes from.

# ── Supabase (required) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — bypasses Row Level Security entirely. Never
# prefix this with NEXT_PUBLIC_. See lib/supabase-service.ts.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cron routes (required if any /api/cron/* route is scheduled) ────
# Shared secret checked against the Authorization: Bearer header Vercel
# Cron sends. Generate any long random string.
CRON_SECRET=

# ── AI features (optional — each feature no-ops without its key) ────
# Session summaries, training-report AI, notes/voice parsing, and the
# Help "Speak to an agent" assistant.
ANTHROPIC_API_KEY=
# Voice transcription (Whisper).
OPENAI_API_KEY=

# ── Exercise library video import (optional) ─────────────────────────
YOUTUBE_API_KEY=

# ── Web Push notifications (optional) ────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@visbuild.co.uk

# ── Stripe billing (optional — dormant during the free-preview period) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_UNLIMITED_MONTHLY=
STRIPE_PRICE_UNLIMITED_YEARLY=

# ── Public demo login (optional — /demo route) ───────────────────────
# A real coach account in a seeded demo org (see scripts/seed-demo-org.js).
DEMO_COACH_EMAIL=
DEMO_COACH_PASSWORD=

# ── Error monitoring (optional) ──────────────────────────────────────
# sentry.{client,server,edge}.config.ts read this. Sentry DSNs are
# public identifiers, not secrets, so one NEXT_PUBLIC_ var covers
# client + server + edge. Entirely dormant (no events sent, no errors
# thrown) until this is set — safe to leave blank.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time (readable stack
# traces in Sentry instead of minified ones). Create at
# sentry.io/settings/account/api/auth-tokens/. Build succeeds fine
# without it — source maps just won't upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Support request emails (optional) ────────────────────────────────
# "Email support" in the help assistant always saves to the
# support_requests table (0116); with these set it also emails you.
# RESEND_API_KEY from resend.com; SUPPORT_EMAIL_FROM must be on a
# domain verified in Resend. Replies go straight to the coach.
RESEND_API_KEY=
SUPPORT_EMAIL_FROM=VIS BUILD Support <support@visbuild.co.uk>
SUPPORT_EMAIL_TO=support@visbuild.co.uk
# Training Report emails + store receipts/reminders (lib/email.ts). Must be on
# a Resend-verified domain; falls back to SUPPORT_EMAIL_FROM.
REPORT_EMAIL_FROM=VIS BUILD <reports@visbuild.co.uk>

# Online Programme Store (0124) - Stripe Connect. Uses STRIPE_SECRET_KEY above.
# In Stripe: Settings > Connect (enable Express accounts), then add a webhook
# endpoint for "Events on Connected accounts" pointing at
# /api/webhooks/stripe-connect with: checkout.session.completed,
# checkout.session.async_payment_succeeded, account.updated, charge.refunded.
STRIPE_CONNECT_WEBHOOK_SECRET=
